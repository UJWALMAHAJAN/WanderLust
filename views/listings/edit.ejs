<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Edit your Listing</h3>
      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=PUT"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            name="listing[title]"
            type="text"
            class="form-control"
            value="<%= listing.title %>"
            required
          />
          <div class="valid-feedback">Title looks Good!</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" required>
           
<%= listing.description %></textarea
          >
          <div class="invalid-feedback">Add a short des..</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label"></label>
          <img
            src="<%= listing.image.url %>"
            alt="Current listing image"
            class="mb-2"
            style="max-width: 200px"
          />
          <input
            name="listing[image][url]"
            type="file"
            accept="image/*"
            class="form-control"
          />
          <div class="form-text">
            Choose a new image only if you want to replace the current one.
          </div>
        </div>
        <!-- key-value pair listing and description -->
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              name="listing[price]"
              type="number"
              class="form-control"
              value="<%= listing.price %>"
              required
            />
            <div class="invalid-feedback">Enter a valid Price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              name="listing[country]"
              type="text"
              class="form-control"
              value="<%= listing.country %>"
              required
            />
            <div class="invalid-feedback">Please enter a country</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            name="listing[location]"
            class="form-control"
            type="text"
            value="<%= listing.location %>"
            required
          />
          <div class="invalid-feedback">Please enter the location</div>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Edit</button>
      </form>
    </div>
  </div>
</body>
